# === Claude API ===
ANTHROPIC_API_KEY=sk-ant-...

# === Panel ===
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=choose-a-long-password
# Optional: separate secret for signing session cookies (defaults to one derived from the password)
SESSION_SECRET=
# Public URL of the panel — used for links in e-mails and for OAuth (MCP)
PUBLIC_BASE_URL=https://agents.mybed.pl
MCP_BASE_URL=https://agents.mybed.pl

# === MyBed Group OS (Supabase project mybed-group-os) ===
OS_SUPABASE_URL=https://fvfydervumwznlopqbsn.supabase.co
OS_SUPABASE_SERVICE_KEY=           # Supabase → Project Settings → API keys → secret / service_role
OS_APP_URL=https://os.mybed.cloud
OS_OWNER_PERSON_ID=p-dominik

# === Dash (Supabase data warehouse: sales, ads, showrooms) ===
DASH_SUPABASE_URL=https://sebckrbvoghfdrppdxyt.supabase.co
DASH_SUPABASE_SERVICE_KEY=

# === E-mail delivery of reports (Resend — same account as MyBed OS; or SMTP) ===
RESEND_API_KEY=
EMAIL_FROM=MyBed Agents <agents@mybed.pl>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# === Google (Gmail, Calendar) — service account with domain-wide delegation ===
GOOGLE_CREDENTIALS_PATH=./credentials/google-credentials.json
GMAIL_USER_EMAIL=dominik.tomaszczyk@mybed.pl

# === WhatsApp bridge ===
# Shared secret between the bridge and the agents (generate: openssl rand -hex 32)
BRIDGE_TOKEN=
WHATSAPP_BRIDGE_URL=http://whatsapp-bridge:3001

# === IdeaERP (today-so-far order metrics) ===
IDEAERP_API_TOKEN=

# === Slack (optional: report delivery / reading channels) ===
SLACK_BOT_TOKEN=

# === PostgreSQL ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agents
POSTGRES_USER=agents
POSTGRES_PASSWORD=changeme_strong_password

# === MCP (Claude.ai connector) ===
# Static key for scripts; Claude.ai uses OAuth (log into the panel and approve)
MCP_API_KEY=
# Extra allowed OAuth redirect hosts (comma-separated), besides claude.ai
OAUTH_REDIRECT_HOSTS=

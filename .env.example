# === Anthropic (Claude API) ===
ANTHROPIC_API_KEY=sk-ant-...

# === Google (Gmail, Calendar, Sheets) ===
# Path to service account JSON or OAuth credentials
GOOGLE_CREDENTIALS_PATH=./credentials/google-credentials.json
GMAIL_USER_EMAIL=your@email.com

# === Slack ===
SLACK_BOT_TOKEN=xoxb-...

# === Asana ===
ASANA_PERSONAL_ACCESS_TOKEN=1/...
ASANA_WORKSPACE_ID=...

# === IdeaERP (IDEA Center) - all stores via single ERP API ===
IDEAERP_API_TOKEN=your-bearer-token-here

# === Shoper (mybed.pl) - legacy, replaced by IdeaERP ===
SHOPER_MYBED_API_URL=https://mybed.pl/webapi/rest/
SHOPER_MYBED_LOGIN=...
SHOPER_MYBED_PASSWORD=...

# === Shoper (mittohome.pl) ===
SHOPER_MITTO_API_URL=https://mittohome.pl/webapi/rest/
SHOPER_MITTO_LOGIN=...
SHOPER_MITTO_PASSWORD=...

# === Shopify (mybed.de) ===
SHOPIFY_MYBED_DE_SHOP=mybed-de.myshopify.com
SHOPIFY_MYBED_DE_ACCESS_TOKEN=shpat_...

# === PostgreSQL ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agents
POSTGRES_USER=agents
POSTGRES_PASSWORD=changeme_strong_password

# === WhatsApp Bridge ===
WHATSAPP_BRIDGE_URL=http://localhost:3001

# === Dashboard ===
DASHBOARD_USERNAME=admin
